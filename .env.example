# 管理アプリ（Vite dev）からサイネージ HTML へのリンク先
# 未設定でも dev では http://localhost:5173/signage/ を自動使用
# VITE_SIGNAGE_URL=http://localhost:5173/signage

# 別ポートでサイネージ単体配信する場合（npm run signage → :8765）
# VITE_SIGNAGE_URL=http://localhost:8765

# ECS Cloud WBGT プロキシ（CORS 回避・本番 HTML の ecsProxy パラメータにも反映）
VITE_ECS_PROXY_URL=http://127.0.0.1:3014/api/ecs/wbgt

# 環境クラウド専用 GAS（gas/gas_ecs_proxy.gs をデプロイした exec URL）
VITE_ECS_GAS_URL=https://script.google.com/macros/s/AKfycbw8QiGNbF9xw6UXlhfyu6lhsCJZCuVFc-jkru3NbjT9RR7DkyUP7f-fBtj5nQDOnp22Fw/exec

# ウェザーニューズ WxTech プロキシ GAS（gas/WxTechProxy.gs をデプロイした exec URL）
# APIキーは GAS の Script Properties（WXTECH_API_KEY）のみ。ここには書かない。
# VITE_WXTECH_GAS_URL=https://script.google.com/macros/s/AKfycbxIdjloOZpfmMCZYLlebfviFUr434H-LlAR1GLPLhDltaRUTqx6tQHAq6Q7Fxy-d_uG/exec
